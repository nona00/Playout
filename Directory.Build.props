<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Playout.Gui' or '$(MSBuildProjectName)' == 'Playout.Engine' or '$(MSBuildProjectName)' == 'Playout.Web'">
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin\</BaseOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
</Project>
