<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Common\PlaylistLibrary.cs" Link="PlaylistLibrary.cs" />
    <Compile Include="..\Common\TrayIcon.cs" Link="TrayIcon.cs" />
    <Compile Include="..\Common\PlayoutLog.cs" Link="PlayoutLog.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Playout.Engine\**" />
    <EmbeddedResource Remove="Playout.Engine\**" />
    <None Remove="Playout.Engine\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Playout.Engine\Playout.Engine.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Playout.Web\Playout.Web.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>